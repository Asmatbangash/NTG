</div></div></div></div></div></div></div></div></div></div></div><!-- cell_inner --></div><!-- cell --></div><!-- port --></section><section data-bb-version="4.7.6" id="bt_bb_section66f63f5de8eef" class="bt_bb_section bt_bb_layout_boxed_1200 bt_bb_vertical_align_top bt_bb_top_spacing_none bt_bb_bottom_spacing_small" style="background-position:top;background-size:contain;" data-bt-override-class="{&quot;bt_bb_top_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_top_spacing_none&quot;,&quot;xxl&quot;:&quot;none&quot;},&quot;bt_bb_bottom_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_bottom_spacing_small&quot;,&quot;xxl&quot;:&quot;small&quot;}}"><div class="bt_bb_port"><div class="bt_bb_cell"><div class="bt_bb_cell_inner"><div class="bt_bb_row " data-bt-override-class="{}" data-structure="12"><div class="bt_bb_row_holder"><div class="bt_bb_column col-xxl-12 col-xl-12 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal" data-width="12" data-bt-override-class="{}"><div class="bt_bb_column_content"><div class="bt_bb_separator bt_bb_border_style_none bt_bb_bottom_spacing_normal" data-bt-override-class="null"></div></div></div></div></div><div class="bt_bb_row " data-bt-override-class="{}" data-structure="4-8"><div class="bt_bb_row_holder"><div class="bt_bb_column col-xxl-4 col-xl-4 col-xs-12 col-sm-12 col-md-12 col-lg-4 bt_bb_vertical_align_top bt_bb_align_left bt_bb_padding_normal bt_bb_animation_fade_in bt_bb_animation_move_up animate animated" data-width="4" data-bt-override-class="{}"><div class="bt_bb_column_content"><div data-bb-version="4.7.6" class="bt_bb_separator bt_bb_border_style_none bt_bb_top_spacing_normal bt_bb_bottom_spacing_none" data-bt-override-class="{&quot;bt_bb_top_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_top_spacing_normal&quot;,&quot;xxl&quot;:&quot;normal&quot;},&quot;bt_bb_bottom_spacing_&quot;:{&quot;current_class&quot;:&quot;bt_bb_bottom_spacing_none&quot;,&quot;xxl&quot;:&quot;none&quot;}}"></div><div data